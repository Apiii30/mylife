# ─── Server ───
PORT=4000
WEB_URL=http://localhost:3000

# ─── Database ───
# Ganti PASSWORD_KAMU dengan password Postgres lokalmu
DATABASE_URL="postgresql://postgres:PASSWORD_KAMU@localhost:5432/mylife_app?schema=public"

# ─── Auth ───
JWT_SECRET="ganti-dengan-string-acak-panjang"
# Harus SAMA dengan INTERNAL_API_SECRET di apps/web/.env.local
INTERNAL_API_SECRET="ganti-dengan-string-acak"

# ─── Cloudinary (diisi saat tahap Gallery) ───
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
