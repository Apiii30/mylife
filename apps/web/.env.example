# URL API Express
NEXT_PUBLIC_API_URL=http://localhost:4000

# NextAuth — https://authjs.dev/getting-started/installation
AUTH_SECRET="jalankan: npx auth secret"
# Harus SAMA dengan INTERNAL_API_SECRET di apps/api/.env
INTERNAL_API_SECRET="sama-dengan-api"

# Login Google (opsional). Kosongkan untuk menyembunyikan tombol Google.
# Buat di https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
